PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subtrack

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS / App URL
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (Optional - used for audience verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Gemini LLM Receipt Parser API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Gmail SMTP Email Reminders via Nodemailer
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an "App Password" (e.g. named SubTrack) and copy the 16-character code
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
EMAIL_FROM=SubTrack <your_email@gmail.com>

# Optional: Vercel Cron Secret (protects /api/reminders/cron from unauthorized requests)
CRON_SECRET=your_random_cron_secret
